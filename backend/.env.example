# Copy to .env and fill in. Never commit .env.
# To generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---------- Server ----------
PORT=3000
NODE_ENV=development
# Behind a reverse proxy (Render, Railway, Nginx...): number of proxies in front of the app.
# Without it, the rate limits see the proxy's IP instead of the client's.
# TRUST_PROXY=1
# Extra browser origins allowed to call the API (comma-separated), e.g. a web version of the app.
# The native apps (capacitor://localhost, https://localhost) are always allowed.
# CORS_ORIGINS=https://app.mesnia.fr

# ---------- Database (MongoDB Atlas) ----------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Mesnia
DB_NAME=Mesnia

# ---------- Secrets (required, 32 characters minimum) ----------
# Signs the session tokens. A different key per environment; changing it logs everyone out.
JWT_SECRET=
# Encrypts the household documents. Required in production. Keep a copy somewhere safe:
# losing it means losing every stored file.
DOCUMENTS_ENCRYPTION_KEY=
# Lets an external cron trigger the daily reminders: POST /api/jobs/daily (optional)
# CRON_SECRET=

# ---------- Emails (Gmail with an app password) ----------
# https://myaccount.google.com/apppasswords
GMAIL_USER=ton.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---------- Recipe import by AI (free tiers) ----------
# Gemini (watches the videos): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (text fallback): https://console.groq.com/keys
GROQ_API_KEY=

# ---------- Push notifications (optional, see PUSH-SETUP.md) ----------
# Firebase service account: the JSON on one line, or base64-encoded
# FIREBASE_SERVICE_ACCOUNT=

# ---------- Password check against known breaches (Have I Been Pwned) ----------
# On by default; "off" to disable (offline development)
# PASSWORD_BREACH_CHECK=off
