# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=WevyDB
DB_NAME=Mesnia

# Server
PORT=3000
NODE_ENV=development
# Derrière un reverse proxy (Render, Railway, Nginx...) : nombre de proxys devant l'app.
# Sans ça, les limites de tentatives voient l'IP du proxy au lieu de celle du client.
# TRUST_PROXY=1

# Clé de signature des sessions, OBLIGATOIRE (32 caractères minimum). À générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Une clé différente par environnement ; la changer déconnecte tout le monde.
JWT_SECRET=

# Gmail (pour l'envoi des emails de reset)
GMAIL_USER=ton.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Groq (extraction de recettes depuis TikTok/Instagram - gratuit, dispo en Europe)
# Clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=...

# Firebase Admin (pour vérifier les tokens)
FIREBASE_PROJECT_ID=your-project-id
# Vous devrez ajouter firebase-adminsdk.json dans le dossier config/

GMAIL_USER=user@gmail.com
GMAIL_APP_PASSWORD=app_password

JWT_SECRET=your_jwt_secret